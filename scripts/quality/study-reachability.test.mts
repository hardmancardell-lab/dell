// @ts-nocheck -- run with the project loader, not compiled by the app build
// Run: node --import ./scripts/ts-loader/register.mjs scripts/quality/study-reachability.test.mts
// The navigation guarantee: no study or tab that was reachable before the rework may become unreachable.
//   - scripts/quality/study-reachability.baseline.json is the frozen list of every tab src/app/page.tsx rendered at
//     commit c8cb756 (generated by study-reachability-parse.mts --write).
//   - Each baseline tab must either still exist in page.tsx with the same component, or be replaced by a registry
//     entry whose variant names that exact old path, the same component and the same props.
//   - Every registry entry must have a working route for every asset class it claims, a loader for its component, and
//     a question a beginner can read.
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { parsePageFile } from "./study-reachability-parse.mts";
import { STUDIES, STUDY_CATEGORIES, ASSET_CLASSES, getVariant } from "../../src/lib/navigation/study-registry.ts";
import { ASSET_GROUPS, DEFAULT_SECONDARY, PRIMARY_TABS, SECONDARY_TABS, TRADING_SECTION_ORDER, groupForAssetClass } from "../../src/lib/navigation/trading-structure.ts";
import { resolveStudyRoute, resolveGlobalStudyRoute } from "../../src/lib/navigation/study-routes.ts";
import { buildNavQuery, parseNavQuery } from "../../src/lib/navigation/nav-state.ts";

const ROOT = fileURLToPath(new URL("../../", import.meta.url));
let bad = 0, passed = 0;
const t = (name: string, ok: boolean, detail = "") => { if (ok) passed++; else bad++; console.log(ok ? "PASS" : "FAIL", name, ok ? "" : "\n  " + detail); };

const baseline = JSON.parse(readFileSync(ROOT + "scripts/quality/study-reachability.baseline.json", "utf8")).tabs;
const current = parsePageFile();
const currentByPath = new Map(current.map((r) => [r.path, r]));
const rendererSource = readFileSync(ROOT + "src/components/navigation/study-components.tsx", "utf8");
const pageSource = readFileSync(ROOT + "src/app/page.tsx", "utf8");

// ---------------------------------------------------------------- registry integrity
const ids = STUDIES.map((s) => s.id);
t("registry ids are unique", new Set(ids).size === ids.length, ids.filter((id, i) => ids.indexOf(id) !== i).join(", "));
t("registry ids are url-safe", ids.every((id) => /^[a-z0-9][a-z0-9-]*$/.test(id)), ids.filter((id) => !/^[a-z0-9][a-z0-9-]*$/.test(id)).join(", "));
t("every entry has a valid category", STUDIES.every((s) => STUDY_CATEGORIES.includes(s.category)), STUDIES.filter((s) => !STUDY_CATEGORIES.includes(s.category)).map((s) => s.id).join(", "));
t("every entry has a title and a one-sentence question", STUDIES.every((s) => s.title.trim() && /\?$/.test(s.question) && s.question.length <= 170 && !/\?.+\?/.test(s.question)), STUDIES.filter((s) => !(s.title.trim() && /\?$/.test(s.question) && s.question.length <= 170 && !/\?.+\?/.test(s.question))).map((s) => `${s.id} (${s.question.length} chars)`).join(", "));
t("every entry names a run time and needs", STUDIES.every((s) => s.runTime && s.needs && typeof s.needs.ticker === "boolean"), "");
t("asset classes are valid", STUDIES.every((s) => s.assetClasses.every((c) => ASSET_CLASSES.includes(c))), "");

const missingVariants: string[] = [];
const strayVariants: string[] = [];
const inPlace = STUDIES.filter((s) => !s.location); // entries run inside the Trading Agent
const external = STUDIES.filter((s) => s.location); // entries that live elsewhere (News hub, Client Research)
for (const s of inPlace) {
  const want = s.assetClasses.length === 0 ? ["all"] : s.assetClasses;
  for (const c of want) if (!s.variants[c]) missingVariants.push(`${s.id}:${c}`);
  for (const k of Object.keys(s.variants)) if (!want.includes(k)) strayVariants.push(`${s.id}:${k}`);
}
t("every claimed asset class has a variant with its props", missingVariants.length === 0, missingVariants.join(", "));
t("no variant for an asset class the entry does not claim", strayVariants.length === 0, strayVariants.join(", "));

const missingLoaders: string[] = [];
for (const s of inPlace) {
  for (const key of new Set([s.component, ...Object.values(s.variants).map((v) => v.component).filter(Boolean)])) {
    if (!new RegExp(`^\\s+${key},\\s*$`, "m").test(rendererSource.split("export const STUDY_COMPONENTS")[1] ?? "")) missingLoaders.push(`${s.id} -> ${key}`);
  }
}
t("every component an entry uses has a lazy loader in study-components.tsx", missingLoaders.length === 0, missingLoaders.join(", "));

// ---------------------------------------------------------------- routes
const routeProblems: string[] = [];
const tradingSections = new Set(SECONDARY_TABS.trading.map((s) => s.id));
for (const s of inPlace) {
  const classes = s.assetClasses.length === 0 ? [undefined] : s.assetClasses;
  for (const c of classes) {
    const r = resolveStudyRoute(s.id, c);
    if (!r) { routeProblems.push(`${s.id}/${c ?? "all"}: no route`); continue; }
    if (r.primaryId !== "trading" || !tradingSections.has(r.secondaryId)) routeProblems.push(`${s.id}/${c ?? "all"}: unknown section ${r.secondaryId}`);
    const group = c ? groupForAssetClass(c) : undefined;
    if (c) {
      if (!group) routeProblems.push(`${s.id}/${c}: no group for asset class`);
      else if (r.secondaryId !== group.id) routeProblems.push(`${s.id}/${c}: routed to ${r.secondaryId}, expected ${group.id}`);
      else if (r.tab !== "studies" && !group.directTabs.some((d) => d.studyId === r.tab)) routeProblems.push(`${s.id}/${c}: tab ${r.tab} is not shown by ${group.id}`);
      else if (r.tab === "studies" && r.studyId !== s.id) routeProblems.push(`${s.id}/${c}: Studies tab route lacks the study id`);
    } else if (r.secondaryId !== s.id) routeProblems.push(`${s.id}: trading-wide tool must open its own tab`);
    const back = parseNavQuery(buildNavQuery(r));
    if (buildNavQuery(back) !== buildNavQuery(r)) routeProblems.push(`${s.id}/${c ?? "all"}: url round trip changed ${buildNavQuery(r)} -> ${buildNavQuery(back)}`);
    const g = resolveGlobalStudyRoute(s.id, c);
    if (!g || g.secondaryId !== "studies" || g.studyId !== s.id) routeProblems.push(`${s.id}/${c ?? "all"}: no global Studies route`);
    else if (buildNavQuery(parseNavQuery(buildNavQuery(g))) !== buildNavQuery(g)) routeProblems.push(`${s.id}/${c ?? "all"}: global route url round trip changed`);
  }
}
t(`every registry entry has a working route for every asset class it claims (${inPlace.length} entries)`, routeProblems.length === 0, routeProblems.join("\n  "));

// Hooks for sections other teams are building (NewsHubTab, ClientResearchView).
const hookProblems: string[] = [];
for (const s of external) {
  if (s.component !== null) hookProblems.push(`${s.id}: an external entry must not name an in-place component`);
  if (s.assetClasses.length !== 0) hookProblems.push(`${s.id}: an external entry applies to any market (assetClasses must be empty)`);
  if (s.status === "planned") {
    if (resolveStudyRoute(s.id) !== undefined) hookProblems.push(`${s.id}: a planned entry must not route anywhere yet`);
  } else {
    // Live: the destination must be a real tab in page.tsx (via trading-structure, which this file checks against page.tsx below).
    const r = resolveStudyRoute(s.id);
    const primaryOk = PRIMARY_TABS.some((p) => p.id === s.location.primaryId);
    const secondaryOk = !s.location.secondaryId || (SECONDARY_TABS[s.location.primaryId] ?? []).some((x) => x.id === s.location.secondaryId);
    if (!r || !primaryOk || !secondaryOk) hookProblems.push(`${s.id}: location ${JSON.stringify(s.location)} is not a tab in page.tsx / trading-structure.ts`);
  }
}
t("Client Research slot exists and is planned or points at a real tab", external.some((e) => e.id === "client-research") && hookProblems.length === 0, hookProblems.join("; ") || "missing client-research entry");
const news = STUDIES.find((s) => s.id === "news-hub");
t("News hub is live: an in-place Trading Agent tab running NewsHubTab, routed to its own tab", !!news && news.component === "NewsHubTab" && !news.location && !news.status && resolveStudyRoute("news-hub")?.secondaryId === "news-hub" && tradingSections.has("news-hub"), JSON.stringify(news));

const groupProblems: string[] = [];
for (const g of ASSET_GROUPS) {
  for (const d of g.directTabs) {
    const s = STUDIES.find((x) => x.id === d.studyId);
    if (!s) groupProblems.push(`${g.id}: direct tab ${d.studyId} is not in the registry`);
    else if (!s.assetClasses.includes(g.assetClass)) groupProblems.push(`${g.id}: direct tab ${d.studyId} does not apply to ${g.assetClass}`);
  }
}
t("every direct tab of every asset group is a registry entry that applies to that group", groupProblems.length === 0, groupProblems.join("\n  "));
t("every asset class has exactly one group", ASSET_CLASSES.every((c) => ASSET_GROUPS.filter((g) => g.assetClass === c).length === 1), "");

// ---------------------------------------------------------------- baseline coverage
const leaves = baseline.filter((r) => !r.hasChildren);
const legacy = new Map<string, { study: any; key: string; variant: any }>();
for (const s of STUDIES) for (const [key, variant] of Object.entries(s.variants)) if (variant.legacyTab) legacy.set(variant.legacyTab, { study: s, key, variant });

const sameComponents = (a: any[], b: any[]) => JSON.stringify(a.map((x) => x.component).sort()) === JSON.stringify(b.map((x) => x.component).sort());
function coverage(byPath: Map<string, any>, registryLegacy: Map<string, any>) {
  const unreachable: string[] = [];
  let viaStructure = 0, viaRegistry = 0;
  for (const row of leaves) {
    const now = byPath.get(row.path);
    if (now && !now.hasChildren && sameComponents(now.components, row.components) && now.wrappers.join() === row.wrappers.join()) { viaStructure++; continue; }
    const hit = registryLegacy.get(row.path);
    if (!hit) { unreachable.push(`${row.path}: not in page.tsx and no registry variant names this old path`); continue; }
    const comp = hit.variant.component ?? hit.study.component;
    const baseComp = row.components[0];
    if (row.components.length !== 1 || comp !== baseComp.component) { unreachable.push(`${row.path}: component ${baseComp?.component} became ${comp}`); continue; }
    // Every prop the old tab passed must be passed with the same value. A variant may add props that equal the component default.
    const diff = Object.entries(baseComp.props).filter(([k, v]) => hit.variant.props[k] !== v);
    if (diff.length) { unreachable.push(`${row.path}: props differ: ${diff.map(([k, v]) => `${k}=${v} (now ${hit.variant.props[k]})`).join(", ")}`); continue; }
    const gated = row.wrappers.includes("RequiresPlacementTier:intermediate");
    if (gated !== (hit.study.tier === "intermediate")) { unreachable.push(`${row.path}: placement-tier gate changed (was ${gated})`); continue; }
    viaRegistry++;
  }
  return { unreachable, viaStructure, viaRegistry };
}

const real = coverage(currentByPath, legacy);
t(`every one of the ${leaves.length} tabs reachable at baseline is still reachable (${real.viaStructure} unchanged in page.tsx, ${real.viaRegistry} through the registry)`, real.unreachable.length === 0, real.unreachable.join("\n  "));

// Self-check of the check itself: if the old Trading group tabs were removed from page.tsx, the registry alone must cover them;
// and if a registry variant were missing, the check must say so.
const groupIds = ASSET_GROUPS.map((g) => `trading/${g.id}/`);
const simulated = new Map([...currentByPath].filter(([p]) => !groupIds.some((g) => p.startsWith(g))));
const sim = coverage(simulated, legacy);
t("simulation: with every old asset-class tab removed from page.tsx, the registry alone still covers all of them", sim.unreachable.length === 0 && sim.viaRegistry === leaves.filter((r) => groupIds.some((g) => r.path.startsWith(g))).length, sim.unreachable.join("; "));
const holey = new Map(legacy); holey.delete("trading/currency/session-analysis");
const missing = coverage(simulated, holey);
t("simulation: dropping one registry variant makes the check fail with a readable line", missing.unreachable.length === 1 && /currency\/session-analysis/.test(missing.unreachable[0]), missing.unreachable.join("; "));
const wrongProps = new Map(legacy); const o = legacy.get("trading/equities/backtest");
wrongProps.set("trading/equities/backtest", { ...o, variant: { ...o.variant, props: { ...o.variant.props, defaultTicker: "MSFT" } } });
const diffProps = coverage(simulated, wrongProps);
t("simulation: a changed default ticker is reported", diffProps.unreachable.length === 1 && /defaultTicker=AAPL/.test(diffProps.unreachable[0]), diffProps.unreachable.join("; "));

const phantom = [...legacy.keys()].filter((p) => !baseline.some((r) => r.path === p));
t("every legacyTab path in the registry is a real baseline path (no typos)", phantom.length === 0, phantom.join(", "));

const groupsStillThere = baseline.filter((r) => r.hasChildren && r.path.split("/").length === 2).filter((r) => !currentByPath.has(r.path)).map((r) => r.path);
t("every baseline secondary tab (Trading groups included) is still a tab in page.tsx", groupsStillThere.length === 0, groupsStillThere.join(", "));

// ---------------------------------------------------------------- structure vs page.tsx
const pageIds = (prefix: string) => current.filter((r) => r.path.startsWith(prefix + "/") && r.path.split("/").length === 2).map((r) => r.path.split("/")[1]);
t("primary tabs in structure match page.tsx", JSON.stringify(current.filter((r) => !r.path.includes("/")).map((r) => r.path)) === JSON.stringify(PRIMARY_TABS.map((p) => p.id)), JSON.stringify(current.filter((r) => !r.path.includes("/")).map((r) => r.path)));
for (const agent of Object.keys(SECONDARY_TABS)) {
  const inPage = pageIds(agent);
  const expected = SECONDARY_TABS[agent].map((s) => s.id);
  t(`${agent}: secondary tabs in structure match page.tsx`, JSON.stringify(inPage) === JSON.stringify(expected), `page: ${inPage.join(",")}\n  structure: ${expected.join(",")}`);
  t(`${agent}: default secondary tab is the first one in page.tsx`, inPage[0] === DEFAULT_SECONDARY[agent], `${inPage[0]} vs ${DEFAULT_SECONDARY[agent]}`);
}
t("trading section order lists exactly the Trading secondary tabs", JSON.stringify(TRADING_SECTION_ORDER) === JSON.stringify(SECONDARY_TABS.trading.map((s) => s.id)), "");

console.log(`\n${passed} passed, ${bad} failed`);
process.exit(bad ? 1 : 0);
